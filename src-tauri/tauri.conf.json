{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Margin",
  "version": "0.1.0-beta.1",
  "identifier": "io.github.becomingw.margin.next",
  "build": {
    "beforeDevCommand": "pnpm pdfium:stage && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm pdfium:stage && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Margin · 页边",
        "dragDropEnabled": false,
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "decorations": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "capabilities": ["default"],
      "csp": null
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "category": "Productivity",
    "publisher": "Becomingw",
    "homepage": "https://github.com/Becomingw/Margin-Next",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "shortDescription": "Local-first manuscript review",
    "longDescription": "Tracked changes, margin conversations and human-controlled AI review proposals.",
    "resources": [
      "pdfium/*"
    ],
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "sidebarImage": "icons/nsis-sidebar.bmp"
      }
    }
  }
}
